# This is a template file. DO NOT commit the actual secrets.yaml file.
# Copy this file to secrets.yaml and fill in your actual values.
# Then base64 encode each value before adding it to the file.
#
# To base64 encode a value:
#   echo -n "your-value-here" | base64
#
# Or use the create-secrets.sh script to generate this file automatically.

apiVersion: v1
kind: Secret
metadata:
  name: carsharing-secrets
  namespace: carsharing
type: Opaque
data:
  # Base64 encoded values
  MONGODB_URI: <base64-encoded-mongodb-uri>
  JWT_SECRET_KEY: <base64-encoded-jwt-secret>
  GOOGLE_API_KEY: <base64-encoded-google-api-key>
  FIREBASE_CONFIG_PATH: <base64-encoded-firebase-config-path>
  FIREBASE_DATABASE_URL: <base64-encoded-firebase-database-url>
