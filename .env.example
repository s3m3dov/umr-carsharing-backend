# MongoDB Configuration
# Replace with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/carsharingDB?retryWrites=true&w=majority&appName=Cluster0

# JWT Configuration
JWT_SECRET_KEY=MjAxOTIwRVlRSTE5ODAxSktOMjgxOTgyNzM4OTFISks=

# Google Maps API (for trip-service)
GOOGLE_API_KEY=your-google-maps-api-key

# Firebase Configuration (for notification-service)
# Optional - comment out if not using Firebase
FIREBASE_CONFIG_PATH=/path/to/firebase-config.json
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# CORS Configuration
ALLOWED_ORIGINS=*
