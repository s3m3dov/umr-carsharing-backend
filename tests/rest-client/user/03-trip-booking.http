### 7) Book ride with driver-accept mechanism (POST /book/new)
POST {{baseUrl}}/trip-service/api/rides/book/new
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "tripId": "{{tripId2}}",
  "passengerId": "{{passengerEmail}}",
  "driverId": "{{driverEmail}}",
  "pickupPoint": {
    "latitude": 50.8154,
    "longitude": 8.6747,
    "placeAddress": "Marburg Hauptbahnhof"
  },
  "destinationPoint": {
    "latitude": 50.7265,
    "longitude": 7.0895,
    "placeAddress": "Bonn Hbf"
  },
  "rideStartTime": "{{tripStartDateTime}}",
  "requestedSeats": 1
}

> {%
client.test("Book ride (driver-accept): status 200 or 201", function() {
  client.assert(response.status === 200 || response.status === 201,
    "Expected 200/201, got " + response.status);
});
client.test("Book ride (driver-accept): response message indicates pending", function() {
  client.assert(response.body.message === "Booking request submitted. Waiting for driver confirmation.",
    "Expected driver-accept message, got: " + response.body.message);
});
%}

