# 03-trip-booking.http
# Run after 01-auth.http and 02-user-vehicle.http

@baseUrl = http://localhost:8888

### 1) Offer trip (driver happy path)
POST {{baseUrl}}/trip-service/api/trips/offer
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{
  "driverId": "{{driverEmail}}",
  "vehicleNumber": "{{vehicleNumber}}",
  "carType": "SEDAN",
  "sourceAddress": {
    "latitude": 50.8154,
    "longitude": 8.6747,
    "placeId": "",
    "placeAddress": "Marburg Hauptbahnhof"
  },
  "destinationAddress": {
    "latitude": 50.7265,
    "longitude": 7.0895,
    "placeId": "",
    "placeAddress": "Bonn Hbf"
  },
  "tripStartDateTime": "{{tripStartDateTime}}",
  "totalSeats": 3
}

> {%
client.test("Offer trip: status 200 or 201", function() {
  client.assert(response.status === 200 || response.status === 201,
    "Expected 200/201, got " + response.status);
});
client.test("Offer trip: tripId returned", function() {
  client.assert(response.body.data != null, "Expected data");
  client.assert(response.body.data.tripId != null, "Expected tripId in data");
});
if (response.body && response.body.data && response.body.data.tripId) {
  client.global.set("tripId", response.body.data.tripId);
}
%}

### 2) Offer trip without auth (negative: expect 401 or 403)
POST {{baseUrl}}/trip-service/api/trips/offer
Content-Type: application/json

{
  "driverId": "{{driverEmail}}",
  "vehicleNumber": "{{vehicleNumber}}",
  "carType": "SEDAN",
  "sourceAddress": { "latitude": 50.8154, "longitude": 8.6747, "placeId": "", "placeAddress": "Marburg Hauptbahnhof" },
  "destinationAddress": { "latitude": 50.7265, "longitude": 7.0895, "placeId": "", "placeAddress": "Bonn Hbf" },
  "tripStartDateTime": "{{tripStartDateTime}}",
  "totalSeats": 3
}

> {%
client.test("Offer trip no auth: status 401 or 403", function() {
  client.assert(response.status === 401 || response.status === 403,
    "Expected 401/403, got " + response.status);
});
%}

### 3) Search matching route (passenger)
GET {{baseUrl}}/trip-service/api/trips/search/matching-route?sourceLatitude=50.8154&sourceLongitude=8.6747&destinationLatitude=50.7265&destinationLongitude=7.0895&requestedSeats=1&effectiveUserId={{passengerEmail}}
Authorization: Bearer {{passengerToken}}
Accept: application/json

> {%
client.test("Search matching route: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Search matching route: returns array", function() {
  client.assert(Array.isArray(response.body.data), "Expected data to be an array");
});
%}

