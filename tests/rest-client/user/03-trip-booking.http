### 9) Passenger active rides — driver-accept booking should be REQUESTED (not yet accepted)
GET {{baseUrl}}/trip-service/api/rides/active/passenger/{{passengerEmail}}
Authorization: Bearer {{passengerToken}}
Accept: application/json

> {%
client.test("Active rides after driver-accept book: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Active rides: driver-accept booking has status REQUESTED", function() {
  var rides = response.body.data;
  var found = false;
  for (var i = 0; i < rides.length; i++) {
    if (rides[i] && rides[i].tripId === client.global.get("tripId2")) {
      found = true;
      client.assert(rides[i].rideStatus === "REQUESTED",
        "Expected driver-accept booking to have status REQUESTED, got " + rides[i].rideStatus);
      if (rides[i].rideId) {
        client.global.set("rideId2", rides[i].rideId);
      }
      break;
    }
  }
  client.assert(found, "Expected to find the driver-accept booking in active rides");
});
%}

### 10) Driver accepts the booking
POST {{baseUrl}}/trip-service/api/bookings/accept?bookingId={{rideId2}}
Authorization: Bearer {{driverToken}}

> {%
client.test("Accept booking: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
%}

### 11) Passenger active rides after driver acceptance — should be CONFIRMED now
GET {{baseUrl}}/trip-service/api/rides/active/passenger/{{passengerEmail}}
Authorization: Bearer {{passengerToken}}
Accept: application/json

> {%
client.test("Active rides after accept: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Active rides after accept: driver-accept booking is now CONFIRMED", function() {
  var rides = response.body.data;
  var found = false;
  for (var i = 0; i < rides.length; i++) {
    if (rides[i] && rides[i].rideId === client.global.get("rideId2")) {
      found = true;
      client.assert(rides[i].rideStatus === "CONFIRMED",
        "Expected status CONFIRMED after driver acceptance, got " + rides[i].rideStatus);
      break;
    }
  }
  client.assert(found, "Expected to find the accepted booking in active rides");
});
%}

