    "latitude": 50.8154,
    "longitude": 8.6747,
    "placeAddress": "Marburg Hauptbahnhof"
  },
  "destinationPoint": {
    "latitude": 50.7265,
    "longitude": 7.0895,
    "placeAddress": "Bonn Hbf"
  },
