### 6) Book ride (passenger happy path)
POST {{baseUrl}}/trip-service/api/rides/book
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "tripId": "{{tripId}}",
  "passengerId": "{{passengerEmail}}",
  "driverId": "{{driverEmail}}",
  "pickupPoint": {
    "latitude": 50.8154,
    "longitude": 8.6747,
    "placeAddress": "Marburg Hauptbahnhof"
  },
  "destinationPoint": {
    "latitude": 50.7265,
    "longitude": 7.0895,
    "placeAddress": "Bonn Hbf"
  },
  "rideStartTime": "{{tripStartDateTime}}",
  "requestedSeats": 1
}

> {%
client.test("Book ride: status 200 or 201", function() {
  client.assert(response.status === 200 || response.status === 201,
    "Expected 200/201, got " + response.status);
});
client.test("Book ride: booking data returned", function() {
  client.assert(response.body.data != null, "Expected data in response");
});
%}

