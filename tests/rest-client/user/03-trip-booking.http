# 03-trip-booking.http
# Run after 01-auth.http and 02-user-vehicle.http

@baseUrl = http://localhost:8888

### 1) Offer trip (driver happy path)
POST {{baseUrl}}/trip-service/api/trips/offer
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{
  "driverId": "{{driverEmail}}",
  "vehicleNumber": "{{vehicleNumber}}",
  "carType": "SEDAN",
  "sourceAddress": {
    "latitude": 50.8154,
    "longitude": 8.6747,
    "placeId": "",
    "placeAddress": "Marburg Hauptbahnhof"
  },
  "destinationAddress": {
    "latitude": 50.7265,
    "longitude": 7.0895,
    "placeId": "",
    "placeAddress": "Bonn Hbf"
  },
  "tripStartDateTime": "{{tripStartDateTime}}",
  "totalSeats": 3
}

> {%
client.test("Offer trip: status 200 or 201", function() {
  client.assert(response.status === 200 || response.status === 201,
    "Expected 200/201, got " + response.status);
});
client.test("Offer trip: tripId returned", function() {
  client.assert(response.body.data != null, "Expected data");
  client.assert(response.body.data.tripId != null, "Expected tripId in data");
});
if (response.body && response.body.data && response.body.data.tripId) {
  client.global.set("tripId", response.body.data.tripId);
}
%}

