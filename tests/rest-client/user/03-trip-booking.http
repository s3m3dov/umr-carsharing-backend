### 12) Accept already-confirmed booking (negative: expect 400 or 409)
POST {{baseUrl}}/trip-service/api/bookings/accept?bookingId={{rideId}}
Authorization: Bearer {{driverToken}}

> {%
client.test("Accept confirmed booking again: status 400 or 409", function() {
  client.assert(response.status === 400 || response.status === 409,
    "Expected 400/409 for already-confirmed booking, got " + response.status);
});
%}

### 13) Passenger active rides after acceptance (expect rideStatus CONFIRMED)
GET {{baseUrl}}/trip-service/api/rides/active/passenger/{{passengerEmail}}
Authorization: Bearer {{passengerToken}}
Accept: application/json

> {%
client.test("Active rides after accept: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Active rides after accept: booking is CONFIRMED", function() {
  var rides = response.body.data;
  var found = false;
  for (var i = 0; i < rides.length; i++) {
    if (rides[i] && rides[i].rideId === client.global.get("rideId")) {
      found = true;
      client.assert(rides[i].status === "CONFIRMED",
        "Expected status CONFIRMED, got " + rides[i].status);
      break;
    }
  }
  client.assert(found, "Expected to find the accepted booking in active rides");
});
%}

