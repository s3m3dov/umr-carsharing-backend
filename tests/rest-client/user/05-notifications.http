# 05-notifications.http
# Run after 01-auth.http (requires driverToken, passengerToken, driverEmail, passengerEmail)

@baseUrl = http://localhost:8888

### 1) Create notification (driver sends to passenger)
POST {{baseUrl}}/notification-service/api/notifications
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{
  "recipientId": "{{passengerEmail}}",
  "senderId": "{{driverEmail}}",
  "title": "Trip update",
  "message": "Your booking has been confirmed",
  "type": "BOOKING_CONFIRMED",
  "relatedEntityId": "{{rideId}}"
}

> {%
client.test("Create notification: status 201", function() {
  client.assert(response.status === 201, "Expected 201, got " + response.status);
});
client.test("Create notification: data returned", function() {
  client.assert(response.body.data != null, "Expected data in response");
  client.assert(response.body.data.notificationId != null, "Expected notificationId");
});
if (response.body && response.body.data && response.body.data.notificationId) {
  client.global.set("notificationId", response.body.data.notificationId);
}
%}

### 2) Create notification on behalf of another user (negative: expect 403)
POST {{baseUrl}}/notification-service/api/notifications
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "recipientId": "{{driverEmail}}",
  "senderId": "{{driverEmail}}",
  "title": "Spoofed notification",
  "message": "This should be rejected",
  "type": "SYSTEM"
}

> {%
client.test("Spoofed sender: status 403", function() {
  client.assert(response.status === 403, "Expected 403 for creating notification on behalf of another user, got " + response.status);
});
%}

### 3) List own notifications (passenger)
GET {{baseUrl}}/notification-service/api/notifications/{{passengerEmail}}?page=0&size=20
Authorization: Bearer {{passengerToken}}
Accept: application/json

> {%
client.test("List notifications: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("List notifications: paginated data returned", function() {
  client.assert(response.body.data != null, "Expected data");
  client.assert(response.body.data.content != null, "Expected paginated content");
  client.assert(Array.isArray(response.body.data.content), "Expected content to be an array");
});
%}

### 4) List notifications for another user (negative: expect 403)
GET {{baseUrl}}/notification-service/api/notifications/{{driverEmail}}?page=0&size=20
Authorization: Bearer {{passengerToken}}
Accept: application/json

> {%
client.test("List other user notifications: status 403", function() {
  client.assert(response.status === 403, "Expected 403 for accessing another user's notifications, got " + response.status);
});
%}

### 5) Get notification stats (passenger)
GET {{baseUrl}}/notification-service/api/notifications/{{passengerEmail}}/stats
Authorization: Bearer {{passengerToken}}
Accept: application/json

> {%
client.test("Notification stats: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Notification stats: counts present", function() {
  client.assert(response.body.data != null, "Expected data");
  client.assert(response.body.data.total != null || response.body.data.unread != null,
    "Expected total or unread count in stats");
});
%}

### 6) Get notification stats for another user (negative: expect 403)
GET {{baseUrl}}/notification-service/api/notifications/{{driverEmail}}/stats
Authorization: Bearer {{passengerToken}}
Accept: application/json

> {%
client.test("Stats for other user: status 403", function() {
  client.assert(response.status === 403, "Expected 403, got " + response.status);
});
%}

### 7) Mark single notification as read (happy path)
PATCH {{baseUrl}}/notification-service/api/notifications/{{notificationId}}/read
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "recipientId": "{{passengerEmail}}"
}

> {%
client.test("Mark as read: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Mark as read: read flag is true", function() {
  client.assert(response.body.data != null, "Expected data");
  client.assert(response.body.data.read === true, "Expected read=true");
});
%}

### 8) Mark non-existent notification as read (negative: expect 404)
PATCH {{baseUrl}}/notification-service/api/notifications/non-existent-id/read
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "recipientId": "{{passengerEmail}}"
}

> {%
client.test("Mark non-existent as read: status 404", function() {
  client.assert(response.status === 404, "Expected 404, got " + response.status);
});
%}

### 9) Mark another user's notification as read (negative: expect 403)
PATCH {{baseUrl}}/notification-service/api/notifications/{{notificationId}}/read
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{
  "recipientId": "{{passengerEmail}}"
}

> {%
client.test("Mark other user notification as read: response received", function() {
  client.assert(response != null && response.status != null,
    "No response received for scenario 9 (mark other user notification as read)");
});
client.test("Mark other user notification as read: status 403", function() {
  client.assert(response.status === 403, "Expected 403, got " + response.status);
});
%}

### 10) Mark all notifications as read (passenger)
PATCH {{baseUrl}}/notification-service/api/notifications/{{passengerEmail}}/read-all
Authorization: Bearer {{passengerToken}}

> {%
client.test("Mark all as read: response received", function() {
  client.assert(response != null && response.status != null,
    "No response received for scenario 10 (mark all notifications as read)");
});
client.test("Mark all as read: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Mark all as read: stats returned", function() {
  client.assert(response.body != null, "Expected response body, got empty response");
  client.assert(response.body.data != null, "Expected stats data in response");
});
client.test("Mark all as read: affected list is not empty", function() {
  var data = response.body && response.body.data;
  if (Array.isArray(data)) {
    client.assert(data.length > 0, "Expected non-empty list after mark-all-read");
    return;
  }
  if (data && Array.isArray(data.notifications)) {
    client.assert(data.notifications.length > 0, "Expected non-empty notifications list after mark-all-read");
    return;
  }
  if (data && Array.isArray(data.updatedNotifications)) {
    client.assert(data.updatedNotifications.length > 0, "Expected non-empty updatedNotifications after mark-all-read");
    return;
  }
  if (data && typeof data.updatedCount === "number") {
    client.assert(data.updatedCount > 0, "Expected updatedCount > 0 after mark-all-read");
    return;
  }
  client.assert(false, "Expected response to include a non-empty affected notifications collection or positive updated count");
});
%}

### 11) Verify unread count is 0 after mark-all-read
GET {{baseUrl}}/notification-service/api/notifications/{{passengerEmail}}/stats
Authorization: Bearer {{passengerToken}}
Accept: application/json

> {%
client.test("Stats after mark-all-read: unread should be 0", function() {
  client.assert(response.status === 200, "Expected 200");
  if (response.body.data && response.body.data.unread != null) {
    client.assert(response.body.data.unread === 0, "Expected unread=0 after mark-all-read");
  }
});
%}
