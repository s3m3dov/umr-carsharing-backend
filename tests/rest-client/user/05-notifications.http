# 05-notifications.http
# Run after 01-auth.http (requires driverToken, passengerToken, driverEmail, passengerEmail)
# May also need 03-trip.http for rideId if testing booking-related notifications

@baseUrl = http://localhost:8888

### 1) Create notification (driver sends to passenger)
POST {{baseUrl}}/notification-service/api/notifications
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{
  "recipientId": "{{passengerEmail}}",
  "senderId": "{{driverEmail}}",
  "title": "Trip update",
  "message": "Your booking has been confirmed",
  "type": "BOOKING_CONFIRMED",
  "relatedEntityId": "{{rideId}}"
}

> {%
client.test("Create notification: status 201", function() {
  client.assert(response.status === 201, "Expected 201, got " + response.status);
});
client.test("Create notification: data returned", function() {
  client.assert(response.body.data != null, "Expected data in response");
  client.assert(response.body.data.notificationId != null, "Expected notificationId");
});
if (response.body && response.body.data && response.body.data.notificationId) {
  client.global.set("notificationId", response.body.data.notificationId);
}
%}

### 2) Get notifications for passenger
GET {{baseUrl}}/notification-service/api/notifications/recipient/{{passengerEmail}}
Authorization: Bearer {{passengerToken}}
Accept: application/json

> {%
client.test("Get notifications: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Get notifications: returns array", function() {
  client.assert(Array.isArray(response.body.data), "Expected data to be an array");
});
client.test("Get notifications: created notification exists", function() {
  var notifications = response.body.data;
  var found = false;
  for (var i = 0; i < notifications.length; i++) {
    if (notifications[i] && notifications[i].notificationId === client.global.get("notificationId")) {
      found = true;
      client.assert(notifications[i].title === "Trip update", "Expected title 'Trip update'");
      break;
    }
  }
  client.assert(found, "Expected to find the created notification");
});
%}

### 3) Get single notification
GET {{baseUrl}}/notification-service/api/notifications/{{notificationId}}
Authorization: Bearer {{passengerToken}}
Accept: application/json

> {%
client.test("Get single notification: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Get single notification: correct data", function() {
  client.assert(response.body.data != null, "Expected data in response");
  client.assert(response.body.data.notificationId === client.global.get("notificationId"),
    "Expected correct notificationId");
});
%}

### 4) Mark notification as read
PUT {{baseUrl}}/notification-service/api/notifications/{{notificationId}}/read
Authorization: Bearer {{passengerToken}}

> {%
client.test("Mark as read: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
%}

### 5) Get unread notification count for passenger
GET {{baseUrl}}/notification-service/api/notifications/unread/count/{{passengerEmail}}
Authorization: Bearer {{passengerToken}}
Accept: application/json

> {%
client.test("Get unread count: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Get unread count: returns count data", function() {
  client.assert(response.body.data != null, "Expected data in response");
  client.assert(response.body.data.unreadCount !== undefined, "Expected unreadCount field");
});
%}

### 6) Get notifications for driver (empty at this point)
GET {{baseUrl}}/notification-service/api/notifications/recipient/{{driverEmail}}
Authorization: Bearer {{driverToken}}
Accept: application/json

> {%
client.test("Get driver notifications: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Get driver notifications: returns array", function() {
  client.assert(Array.isArray(response.body.data), "Expected data to be an array");
});
%}

### 7) Delete notification
DELETE {{baseUrl}}/notification-service/api/notifications/{{notificationId}}
Authorization: Bearer {{passengerToken}}

> {%
client.test("Delete notification: status 200 or 204", function() {
  client.assert(response.status === 200 || response.status === 204,
    "Expected 200/204, got " + response.status);
});
%}

### 8) Get deleted notification (negative: expect 404)
GET {{baseUrl}}/notification-service/api/notifications/{{notificationId}}
Authorization: Bearer {{passengerToken}}
Accept: application/json

> {%
client.test("Get deleted notification: status 404", function() {
  client.assert(response.status === 404, "Expected 404, got " + response.status);
});
%}

### 9) Create notification without auth (negative: expect 401 or 403)
POST {{baseUrl}}/notification-service/api/notifications
Content-Type: application/json

{
  "recipientId": "{{passengerEmail}}",
  "senderId": "{{driverEmail}}",
  "title": "Unauthorized notification",
  "message": "This should fail",
  "type": "GENERAL"
}

> {%
client.test("Create notification no auth: status 401 or 403", function() {
  client.assert(response.status === 401 || response.status === 403,
    "Expected 401/403, got " + response.status);
});
%}

### 10) Get someone else's notifications (negative: expect 403)
GET {{baseUrl}}/notification-service/api/notifications/recipient/{{driverEmail}}
Authorization: Bearer {{passengerToken}}
Accept: application/json

> {%
client.test("Get other user's notifications: status 403", function() {
  client.assert(response.status === 403, "Expected 403, got " + response.status);
});
%}
