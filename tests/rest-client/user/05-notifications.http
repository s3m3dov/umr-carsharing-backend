### 9) Create notification without auth (negative: expect 401)
POST {{baseUrl}}/notification-service/api/notifications
Content-Type: application/json

{
  "recipientId": "{{passengerEmail}}",
  "senderId": "{{driverEmail}}",
  "title": "Unauthorized notification",
  "message": "This should fail",
  "type": "GENERAL"
}

> {%
client.test("Create notification no auth: status 401", function() {
  client.assert(response.status === 401, "Expected 401, got " + response.status);
});
%}

