### 16) Passenger active rides — auto-confirm booking should be CONFIRMED
GET {{baseUrl}}/trip-service/api/rides/active/passenger/{{passengerEmail}}
Authorization: Bearer {{passengerToken}}
Accept: application/json

> {%
client.test("Passenger active rides: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Passenger active rides: returns array", function() {
  client.assert(Array.isArray(response.body.data), "Expected data to be an array");
});
client.test("Passenger active rides: list is not empty", function() {
  client.assert(Array.isArray(response.body.data) && response.body.data.length > 0,
    "Expected at least one active ride, got empty list");
});
client.test("Passenger active rides: auto-confirmed booking has status CONFIRMED", function() {
  var rides = response.body.data;
  var found = false;
  for (var i = 0; i < rides.length; i++) {
    if (rides[i] && rides[i].tripId === client.global.get("tripId")) {
      found = true;
      client.assert(rides[i].rideStatus === "CONFIRMED",
        "Expected auto-confirmed booking to have status CONFIRMED immediately, got " + rides[i].rideStatus);
      break;
    }
  }
  client.assert(found, "Expected to find the auto-confirmed booking in active rides");
});
if (response.body && response.body.data && Array.isArray(response.body.data)) {
  var rides = response.body.data;
  var selected = null;
  for (var i = 0; i < rides.length; i++) {
    if (rides[i] && rides[i].tripId === client.global.get("tripId")) {
      selected = rides[i];
      break;
    }
  }
  if (!selected && rides.length > 0) {
    selected = rides[0];
  }
  if (selected && selected.rideId) {
    client.global.set("rideId", selected.rideId);
  }
  for (var i = 0; i < rides.length; i++) {
    if (rides[i] && rides[i].rideId && rides[i].rideId !== client.global.get("rideId")) {
      client.global.set("rideIdForCancel", rides[i].rideId);
      break;
    }
  }
  if (!client.global.get("rideIdForCancel") && rides.length > 1) {
    client.global.set("rideIdForCancel", rides[1].rideId);
  }
}
%}

