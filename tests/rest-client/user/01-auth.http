# 01-auth.http
# Run this file first (user/driver/passenger scope only).

@baseUrl = http://localhost:8888

### 0) Health check
GET {{baseUrl}}/user-service/api/users/health
Accept: application/json

> {%
client.test("Health check: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
%}

### 1) Signup driver (happy path)
POST {{baseUrl}}/auth-service/api/auth/signup
Content-Type: application/json

{
  "firstName": "Manual",
  "lastName": "Driver",
  "email": "{{driverEmail}}",
  "password": "{{driverPassword}}",
  "userType": "DRIVER",
  "phoneNumber": "+49 123 456789",
  "age": 30,
  "licenseNumber": "D-{{runId}}"
}

> {%
client.test("Signup driver: status 200 or 201", function() {
  client.assert(response.status === 200 || response.status === 201,
    "Expected 200/201, got " + response.status);
});
client.test("Signup driver: data field present", function() {
  client.assert(response.body.data != null, "Expected data in response");
});
client.test("Signup driver: token returned", function() {
  client.assert(response.body.data.token != null, "Expected token in data");
});
client.test("Signup driver: userId returned", function() {
  client.assert(response.body.data.userId != null || response.body.data.email != null,
    "Expected userId or email in data");
});
if (response.body && response.body.data && response.body.data.token) {
  client.global.set("driverToken", response.body.data.token);
}
%}

### 2) Signup passenger (happy path)
POST {{baseUrl}}/auth-service/api/auth/signup
Content-Type: application/json

{
  "firstName": "Manual",
  "lastName": "Passenger",
  "email": "{{passengerEmail}}",
  "password": "{{passengerPassword}}",
  "userType": "PASSENGER",
  "phoneNumber": "+49 111 222333",
  "age": 24,
  "licenseNumber": ""
}

> {%
client.test("Signup passenger: status 200 or 201", function() {
  client.assert(response.status === 200 || response.status === 201,
    "Expected 200/201, got " + response.status);
});
client.test("Signup passenger: data field present", function() {
  client.assert(response.body.data != null, "Expected data in response");
});
client.test("Signup passenger: token returned", function() {
  client.assert(response.body.data.token != null, "Expected token in data");
});
if (response.body && response.body.data && response.body.data.token) {
  client.global.set("passengerToken", response.body.data.token);
}
%}

### 3) Duplicate signup (negative: expect 409 USER_ALREADY_EXISTS)
POST {{baseUrl}}/auth-service/api/auth/signup
Content-Type: application/json

{
  "firstName": "Manual",
  "lastName": "Driver",
  "email": "{{driverEmail}}",
  "password": "{{driverPassword}}",
  "userType": "DRIVER",
  "phoneNumber": "+49 123 456789",
  "age": 30,
  "licenseNumber": "D-{{runId}}"
}

> {%
client.test("Duplicate signup: status 409", function() {
  client.assert(response.status === 409, "Expected 409, got " + response.status);
});
client.test("Duplicate signup: error field set", function() {
  client.assert(response.body.error != null, "Expected error field in response");
});
client.test("Duplicate signup: error code returned", function() {
  client.assert(response.body.code != null, "Expected error code");
});
%}

### 4) Login driver (fallback + token refresh)
POST {{baseUrl}}/auth-service/api/auth/login
Content-Type: application/json

{
  "email": "{{driverEmail}}",
  "password": "{{driverPassword}}"
}

> {%
client.test("Login driver: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Login driver: data field present", function() {
  client.assert(response.body.data != null, "Expected data in response");
});
client.test("Login driver: token returned", function() {
  client.assert(response.body.data.token != null, "Expected token in data");
});
if (response.body && response.body.data) {
  if (response.body.data.token) {
    client.global.set("driverToken", response.body.data.token);
  }
  if (response.body.data.email) {
    client.global.set("driverEmail", response.body.data.email);
  }
}
%}

### 5) Login passenger (fallback + token refresh)
POST {{baseUrl}}/auth-service/api/auth/login
Content-Type: application/json

{
  "email": "{{passengerEmail}}",
  "password": "{{passengerPassword}}"
}

> {%
client.test("Login passenger: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Login passenger: token returned", function() {
  client.assert(response.body.data != null, "Expected data");
  client.assert(response.body.data.token != null, "Expected token");
});
if (response.body && response.body.data) {
  if (response.body.data.token) {
    client.global.set("passengerToken", response.body.data.token);
  }
  if (response.body.data.email) {
    client.global.set("passengerEmail", response.body.data.email);
  }
}
%}

### 6) Login with wrong password (negative: expect 401)
POST {{baseUrl}}/auth-service/api/auth/login
Content-Type: application/json

{
  "email": "{{driverEmail}}",
  "password": "WrongPassword123!"
}

> {%
client.test("Wrong password: status 401", function() {
  client.assert(response.status === 401, "Expected 401, got " + response.status);
});
client.test("Wrong password: no token in response", function() {
  client.assert(response.body.data == null || response.body.data.token == null,
    "Token must not be returned on failed login");
});
%}

### 7) Login with non-existent email (negative: expect 401)
POST {{baseUrl}}/auth-service/api/auth/login
Content-Type: application/json

{
  "email": "nobody-{{runId}}@example.com",
  "password": "SomePassword123!"
}

> {%
client.test("Non-existent email login: status 401", function() {
  client.assert(response.status === 401, "Expected 401, got " + response.status);
});
%}

### 8) Validate driver token (happy path)
POST {{baseUrl}}/auth-service/api/auth/validate
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{
  "token": "{{driverToken}}"
}

> {%
client.test("Validate token: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Validate token: data field present", function() {
  client.assert(response.body.data != null, "Expected data in response");
});
client.test("Validate token: isValid true", function() {
  client.assert(response.body.data.isValid === true, "Expected isValid=true");
});
%}

### 9) Validate malformed token (negative: expect 401)
POST {{baseUrl}}/auth-service/api/auth/validate
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{
  "token": "this.is.not.a.valid.jwt"
}

> {%
client.test("Malformed token: status 401", function() {
  client.assert(response.status === 401, "Expected 401, got " + response.status);
});
client.test("Malformed token: UNAUTHORIZED code", function() {
  client.assert(response.body.code === "UNAUTHORIZED", "Expected UNAUTHORIZED code");
});
%}

### 10) Validate empty token string (negative: expect 401)
POST {{baseUrl}}/auth-service/api/auth/validate
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{
  "token": ""
}

> {%
client.test("Empty token: status 401 or 422", function() {
  client.assert(response.status === 401 || response.status === 422,
    "Expected 401 (invalid token) or 422 (blank token rejected by validation), got " + response.status);
});
%}

### 11) Change password - wrong current password (negative: expect 401)
PUT {{baseUrl}}/auth-service/api/auth/change-password
Content-Type: application/json
Authorization: Bearer {{driverToken}}

{
  "currentPassword": "TotallyWrongPassword!",
  "newPassword": "NewPassword456!"
}

> {%
client.test("Change password wrong current: status 401", function() {
  client.assert(response.status === 401, "Expected 401, got " + response.status);
});
%}

### 12) Change password - no auth (negative: expect 401 or 403)
PUT {{baseUrl}}/auth-service/api/auth/change-password
Content-Type: application/json

{
  "currentPassword": "{{driverPassword}}",
  "newPassword": "NewPassword456!"
}

> {%
client.test("Change password no auth: status 401 or 403", function() {
  client.assert(response.status === 401 || response.status === 403,
    "Expected 401/403, got " + response.status);
});
%}

### 13) Change password - correct current password (happy path)
PUT {{baseUrl}}/auth-service/api/auth/change-password
Content-Type: application/json
Authorization: Bearer {{driverToken}}

{
  "currentPassword": "{{driverPassword}}",
  "newPassword": "NewPassword456!"
}

> {%
client.test("Change password: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
%}

### 14) Login with old password after change (negative: expect 401)
POST {{baseUrl}}/auth-service/api/auth/login
Content-Type: application/json

{
  "email": "{{driverEmail}}",
  "password": "{{driverPassword}}"
}

> {%
client.test("Old password after change: status 401", function() {
  client.assert(response.status === 401, "Expected 401 - old password should be rejected");
});
%}

### 15) Login with new password after change (verify password was actually changed)
POST {{baseUrl}}/auth-service/api/auth/login
Content-Type: application/json

{
  "email": "{{driverEmail}}",
  "password": "NewPassword456!"
}

> {%
client.test("New password login: status 200", function() {
  client.assert(response.status === 200, "Expected 200 - new password should work");
});
client.test("New password login: token returned", function() {
  client.assert(response.body.data != null && response.body.data.token != null,
    "Expected token after login with new password");
});
if (response.body && response.body.data && response.body.data.token) {
  client.global.set("driverToken", response.body.data.token);
}
%}

### 16) Initiate password reset (happy path)
POST {{baseUrl}}/auth-service/api/auth/reset-password
Content-Type: application/json

{
  "email": "{{passengerEmail}}"
}

> {%
client.test("Initiate password reset: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
%}

### 17) Initiate password reset for non-existent email (negative: expect 404 or 200 silent)
POST {{baseUrl}}/auth-service/api/auth/reset-password
Content-Type: application/json

{
  "email": "nobody-{{runId}}@example.com"
}

> {%
client.test("Password reset non-existent email: status 200 or 404", function() {
  // Some implementations return 200 silently to avoid email enumeration
  client.assert(response.status === 200 || response.status === 404,
    "Expected 200 or 404, got " + response.status);
});
%}

### 18) Confirm password reset with invalid token (negative: expect 401 or 400)
POST {{baseUrl}}/auth-service/api/auth/reset-password/confirm
Content-Type: application/json

{
  "token": "invalid-reset-token-{{runId}}",
  "newPassword": "ResetPassword789!"
}

> {%
client.test("Password reset invalid token: status 400 or 401", function() {
  client.assert(response.status === 400 || response.status === 401,
    "Expected 400/401, got " + response.status);
});
%}
