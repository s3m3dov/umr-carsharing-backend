# 04-review-cancel-negative.http
# Run after 03-trip-booking.http

@baseUrl = http://localhost:8888

### 1) Submit review before trip completion (negative: expect 400 TRIP_NOT_COMPLETED)
POST {{baseUrl}}/review-service/api/reviews/driver
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "userId": "{{passengerEmail}}",
  "userRole": "PASSENGER",
  "tripId": "{{tripId}}",
  "bookingId": "{{rideId}}",
  "rating": 5,
  "comment": "Attempting review before completion"
}

> {%
client.test("Review before completion: status 400", function() {
  client.assert(response.status === 400, "Expected 400 TRIP_NOT_COMPLETED, got " + response.status);
});
client.test("Review before completion: error field set", function() {
  client.assert(response.body.error != null, "Expected error field in response");
});
%}

### 2) Submit review for non-existent booking (negative: expect 404)
POST {{baseUrl}}/review-service/api/reviews/driver
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "userId": "{{passengerEmail}}",
  "userRole": "PASSENGER",
  "tripId": "{{tripId}}",
  "bookingId": "non-existent-booking-id",
  "rating": 4,
  "comment": "Review for missing booking"
}

> {%
client.test("Review non-existent booking: status 400 or 404", function() {
  client.assert(response.status === 400 || response.status === 404,
    "Expected 400/404, got " + response.status);
});
%}

### 3) Unauthorized trip cancellation by passenger (negative: expect 401/403)
POST {{baseUrl}}/trip-service/api/trips/cancel
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "userId": "{{passengerEmail}}",
  "tripId": "{{tripId}}",
  "cancellationReason": "Passenger should not cancel whole trip"
}

> {%
client.test("Passenger cancels trip: status 401 or 403", function() {
  client.assert(response.status === 401 || response.status === 403,
    "Expected 401/403 - only driver can cancel a trip, got " + response.status);
});
%}

### 4) Cancel trip by wrong driver (negative: expect 401)
POST {{baseUrl}}/trip-service/api/trips/cancel
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "userId": "{{passengerEmail}}",
  "tripId": "{{tripId}}",
  "cancellationReason": "Wrong user attempts cancel"
}

> {%
client.test("Trip cancel by non-owner: status 401 or 403", function() {
  client.assert(response.status === 401 || response.status === 403,
    "Expected 401/403, got " + response.status);
});
%}

### 5) Passenger cancels own ride (happy path)
POST {{baseUrl}}/trip-service/api/rides/cancel
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "userId": "{{passengerEmail}}",
  "tripId": "{{tripId}}",
  "rideId": "{{rideId}}",
  "cancellationReason": "Manual test cancellation"
}

> {%
client.test("Cancel ride: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Cancel ride: success message", function() {
  client.assert(response.body.data != null || response.body.message != null,
    "Expected confirmation in response");
});
%}

### 6) Cancel same ride again (negative: expect 409 ALREADY_CANCELLED)
POST {{baseUrl}}/trip-service/api/rides/cancel
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "userId": "{{passengerEmail}}",
  "tripId": "{{tripId}}",
  "rideId": "{{rideId}}",
  "cancellationReason": "Second cancellation attempt"
}

> {%
client.test("Cancel already-cancelled ride: status 409", function() {
  client.assert(response.status === 409, "Expected 409 ALREADY_CANCELLED, got " + response.status);
});
%}

### 7) Cancel non-existent ride (negative: expect 404)
POST {{baseUrl}}/trip-service/api/rides/cancel
Authorization: Bearer {{passengerToken}}
Content-Type: application/json

{
  "userId": "{{passengerEmail}}",
  "tripId": "{{tripId}}",
  "rideId": "non-existent-ride-id",
  "cancellationReason": "Does not exist"
}

> {%
client.test("Cancel non-existent ride: status 404", function() {
  client.assert(response.status === 404, "Expected 404, got " + response.status);
});
%}

### 8) Driver cancels trip (happy path)
POST {{baseUrl}}/trip-service/api/trips/cancel
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{
  "userId": "{{driverEmail}}",
  "tripId": "{{tripId}}",
  "cancellationReason": "Manual test wrap-up"
}

> {%
client.test("Driver cancel trip: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Driver cancel trip: response mentions cancelled", function() {
  var msg = response.body.data || response.body.message || "";
  client.assert(typeof msg === "string" && msg.toLowerCase().indexOf("cancel") !== -1,
    "Expected cancellation confirmation message");
});
%}

### 9) Cancel already-cancelled trip (negative: expect 409)
POST {{baseUrl}}/trip-service/api/trips/cancel
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{
  "userId": "{{driverEmail}}",
  "tripId": "{{tripId}}",
  "cancellationReason": "Second cancel attempt"
}

> {%
client.test("Cancel already-cancelled trip: status 409", function() {
  client.assert(response.status === 409, "Expected 409, got " + response.status);
});
%}

### 10) Access protected endpoint without token (negative: expect 401)
GET {{baseUrl}}/trip-service/api/trips/active/driver/{{driverEmail}}
Accept: application/json

> {%
client.test("Access without token: status 401", function() {
  client.assert(response.status === 401, "Expected 401 without auth token, got " + response.status);
});
%}
