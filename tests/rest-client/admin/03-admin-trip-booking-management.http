### 12) Admin update booking status to CONFIRMED
PUT {{baseUrl}}/trip-service/api/admin/bookings/{{admin_booking_id}}
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "status": "CONFIRMED"
}

> {%
client.test("Admin update booking: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
%}

### 13) Admin reject a booking (negative: use a separate booking id if needed)
POST {{baseUrl}}/trip-service/api/bookings/reject?bookingId={{admin_booking_id}}
Authorization: Bearer {{admin_driver_token}}

> {%
client.test("Reject booking: status 200 or 400/409 (if already CONFIRMED)", function() {
  // May be 400/409 since booking was just CONFIRMED above — both are valid outcomes
  client.assert(response.status === 200 || response.status === 400 || response.status === 409,
    "Expected 200/400/409, got " + response.status);
});
%}

