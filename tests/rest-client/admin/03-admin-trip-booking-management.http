# admin/03-admin-trip-booking-management.http
# Run after admin/02-admin-user-management.http

@baseUrl = http://localhost:8888

### 1) Driver offers trip fixture for admin trip/booking endpoints
POST {{baseUrl}}/trip-service/api/trips/offer
Authorization: Bearer {{admin_driver_token}}
Content-Type: application/json

{
  "sourceAddress": {
    "latitude": 50.8154,
    "longitude": 8.6747,
    "placeId": "",
    "placeAddress": "Marburg Hauptbahnhof"
  },
  "destinationAddress": {
    "latitude": 50.7265,
    "longitude": 7.0895,
    "placeId": "",
    "placeAddress": "Bonn Hbf"
  },
  "tripStartDateTime": "{{admin_trip_start}}",
  "totalSeats": 3,
  "pricePerSeat": 5.0
}

> {%
client.test("Driver offer trip: status 200 or 201", function() {
  client.assert(response.status === 200 || response.status === 201,
    "Expected 200/201, got " + response.status);
});
client.test("Driver offer trip: data field present", function() {
  client.assert(response.body.data != null, "Expected data in response");
});
client.test("Driver offer trip: tripId returned", function() {
  client.assert(response.body.data.tripId != null, "Expected tripId in data");
});
if (response.body && response.body.data && response.body.data.tripId) {
  client.global.set("admin_trip_id", response.body.data.tripId);
}
%}

### 2) Passenger books trip fixture for admin booking endpoints
POST {{baseUrl}}/trip-service/api/rides/book
Authorization: Bearer {{admin_passenger_token}}
Content-Type: application/json

{
  "tripId": "{{admin_trip_id}}",
  "passengerId": "{{admin_passenger_id}}",
  "driverId": "{{admin_driver_id}}",
  "pickupPoint": {
    "latitude": 50.8154,
    "longitude": 8.6747,
    "placeAddress": "Marburg Hauptbahnhof"
  },
  "destinationPoint": {
    "latitude": 50.7265,
    "longitude": 7.0895,
    "placeAddress": "Bonn Hbf"
  },
  "rideStartTime": "{{admin_trip_start}}",
  "requestedSeats": 1
}

> {%
client.test("Passenger book trip: status 200 or 201", function() {
  client.assert(response.status === 200 || response.status === 201,
    "Expected 200/201, got " + response.status);
});
%}

### 3) Resolve bookingId from passenger active rides
GET {{baseUrl}}/trip-service/api/rides/active/passenger/{{admin_passenger_id}}
Authorization: Bearer {{admin_passenger_token}}
Accept: application/json

> {%
client.test("Resolve booking: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
if (response.body && response.body.data && Array.isArray(response.body.data)) {
  var rides = response.body.data;
  for (var i = 0; i < rides.length; i++) {
    if (rides[i] && rides[i].tripId === client.global.get("admin_trip_id")) {
      client.global.set("admin_booking_id", rides[i].rideId);
      break;
    }
  }
}
%}

### 4) Admin list trips
GET {{baseUrl}}/trip-service/api/admin/trips?page=0&size=20
Authorization: Bearer {{admin_token}}
Accept: application/json

> {%
client.test("Admin list trips: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Admin list trips: data field present", function() {
  client.assert(response.body.data != null, "Expected data in response");
});
client.test("Admin list trips: paginated content present", function() {
  client.assert(response.body.data.content != null, "Expected paginated content");
});
%}

