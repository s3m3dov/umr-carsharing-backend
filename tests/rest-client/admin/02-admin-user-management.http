### 11) Admin create passenger
POST {{baseUrl}}/user-service/api/admin/passengers
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "email": "admin-extra-passenger-{{admin_runId}}@example.com",
  "firstName": "Extra",
  "lastName": "Passenger",
  "phoneNumber": "+49 705 200302",
  "age": 27
}

> {%
client.test("Admin create passenger: status 200 or 201", function() {
  client.assert(response.status === 200 || response.status === 201,
    "Expected 200/201, got " + response.status);
});
%}

