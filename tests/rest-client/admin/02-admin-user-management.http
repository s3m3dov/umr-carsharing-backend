### 14) Driver creates own vehicle fixture for trip flow
POST {{baseUrl}}/user-service/api/vehicles/register
Authorization: Bearer {{admin_driver_token}}
Content-Type: application/json

{
  "userId": "{{admin_driver_id}}",
  "vehicleName": "Admin Driver Car",
  "vehicleNumber": "{{admin_driver_vehicle_number}}",
  "vehicleType": "sedan",
  "vehicleColor": "white",
  "seatingCapacity": "4"
}

> {%
client.test("Driver register vehicle: status 201", function() {
  client.assert(response.status === 201, "Expected 201, got " + response.status);
});
%}

### 15) Resolve created vehicleId by vehicle number
GET {{baseUrl}}/user-service/api/admin/vehicles?page=0&size=50
Authorization: Bearer {{admin_token}}
Accept: application/json

> {%
client.test("Resolve vehicleId: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
if (response.body && response.body.data && response.body.data.content) {
  var items = response.body.data.content;
  for (var i = 0; i < items.length; i++) {
    if (items[i] && items[i].vehicleNumber === client.global.get("admin_vehicle_number")) {
      client.global.set("admin_vehicle_id", items[i].id);
      break;
    }
  }
}
%}

