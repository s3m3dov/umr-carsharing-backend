# admin/02-admin-user-management.http
# Run after admin/01-admin-auth.http

@baseUrl = http://localhost:8888

### 1) Admin list drivers
GET {{baseUrl}}/user-service/api/admin/drivers?page=0&size=20
Authorization: Bearer {{admin_token}}
Accept: application/json

> {%
client.test("Admin list drivers: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Admin list drivers: data field present", function() {
  client.assert(response.body.data != null, "Expected data in response");
});
client.test("Admin list drivers: paginated content present", function() {
  client.assert(response.body.data.content != null, "Expected paginated content");
});
%}

### 2) Admin get driver detail
GET {{baseUrl}}/user-service/api/admin/drivers/{{admin_driver_id}}
Authorization: Bearer {{admin_token}}
Accept: application/json

> {%
client.test("Admin get driver: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Admin get driver: userId matches", function() {
  client.assert(response.body.data != null, "Expected data");
});
%}

### 3) Admin get non-existent driver (negative: expect 404)
GET {{baseUrl}}/user-service/api/admin/drivers/nobody-does-not-exist@example.com
Authorization: Bearer {{admin_token}}
Accept: application/json

> {%
client.test("Admin get non-existent driver: status 404", function() {
  client.assert(response.status === 404, "Expected 404, got " + response.status);
});
%}

### 4) Non-admin access to admin endpoint (negative: expect 403)
GET {{baseUrl}}/user-service/api/admin/drivers?page=0&size=20
Authorization: Bearer {{admin_driver_token}}
Accept: application/json

> {%
client.test("Non-admin list drivers: status 403", function() {
  client.assert(response.status === 403, "Expected 403 for non-admin access, got " + response.status);
});
%}

