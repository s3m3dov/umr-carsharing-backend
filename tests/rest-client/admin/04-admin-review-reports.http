### 14) Cleanup - admin cancels booking
DELETE {{baseUrl}}/trip-service/api/admin/bookings/{{admin_booking_id}}
Authorization: Bearer {{admin_token}}

### 15) Cleanup - admin cancels trip
DELETE {{baseUrl}}/trip-service/api/admin/trips/{{admin_trip_id}}
Authorization: Bearer {{admin_token}}

### 16) Cleanup - admin removes review
DELETE {{baseUrl}}/review-service/api/admin/reviews/{{admin_review_id}}
Authorization: Bearer {{admin_token}}

### 17) Cleanup - admin deletes managed vehicle
DELETE {{baseUrl}}/user-service/api/admin/vehicles/{{admin_vehicle_id}}
Authorization: Bearer {{admin_token}}

### 18) Cleanup - admin deletes passenger
DELETE {{baseUrl}}/user-service/api/admin/passengers/{{admin_passenger_id}}
Authorization: Bearer {{admin_token}}

### 19) Cleanup - admin deletes driver
DELETE {{baseUrl}}/user-service/api/admin/drivers/{{admin_driver_id}}
Authorization: Bearer {{admin_token}}
