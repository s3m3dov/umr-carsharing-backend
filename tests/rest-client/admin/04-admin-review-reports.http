# admin/04-admin-review-reports.http
# Run after admin/03-admin-trip-booking-management.http

@baseUrl = http://localhost:8888

### 1) Driver submits review for passenger (create admin-manageable review)
POST {{baseUrl}}/review-service/api/reviews/passenger
Authorization: Bearer {{admin_driver_token}}
Content-Type: application/json

{
  "userId": "{{admin_driver_id}}",
  "userRole": "DRIVER",
  "tripId": "{{admin_trip_id}}",
  "bookingId": "{{admin_booking_id}}",
  "rating": 4,
  "comment": "Admin fixture review"
}

> {%
client.test("Submit review: status 200 or 201", function() {
  // May fail with 400 if trip is not yet COMPLETED — acceptable in this fixture
  client.assert(response.status === 200 || response.status === 201 || response.status === 400,
    "Expected 200/201 or 400 (trip not complete), got " + response.status);
});
%}

### 2) Admin list reviews
GET {{baseUrl}}/review-service/api/admin/reviews?page=0&size=20
Authorization: Bearer {{admin_token}}
Accept: application/json

> {%
client.test("Admin list reviews: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Admin list reviews: paginated data", function() {
  client.assert(response.body.data != null && response.body.data.content != null,
    "Expected paginated content");
});
if (response.body && response.body.data && response.body.data.content) {
  var content = response.body.data.content;
  for (var i = 0; i < content.length; i++) {
    if (content[i] && content[i].tripId === client.global.get("admin_trip_id")) {
      client.global.set("admin_review_id", content[i].reviewId);
      break;
    }
  }
}
%}

### 3) Admin get review detail
GET {{baseUrl}}/review-service/api/admin/reviews/{{admin_review_id}}
Authorization: Bearer {{admin_token}}
Accept: application/json

> {%
client.test("Admin get review: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
%}

### 4) Admin get non-existent review (negative: expect 404)
GET {{baseUrl}}/review-service/api/admin/reviews/non-existent-review-id
Authorization: Bearer {{admin_token}}
Accept: application/json

> {%
client.test("Admin get non-existent review: status 404", function() {
  client.assert(response.status === 404, "Expected 404, got " + response.status);
});
%}

### 5) Non-admin flag review (negative: expect 403)
POST {{baseUrl}}/review-service/api/admin/reviews/{{admin_review_id}}/flag
Authorization: Bearer {{admin_driver_token}}

> {%
client.test("Non-admin flag review: status 403", function() {
  client.assert(response.status === 403, "Expected 403 for non-admin flag, got " + response.status);
});
%}

### 6) Admin flag review
POST {{baseUrl}}/review-service/api/admin/reviews/{{admin_review_id}}/flag
Authorization: Bearer {{admin_token}}

> {%
client.test("Admin flag review: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
%}

### 7) Admin publish review
POST {{baseUrl}}/review-service/api/admin/reviews/{{admin_review_id}}/publish
Authorization: Bearer {{admin_token}}

> {%
client.test("Admin publish review: status 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
%}

